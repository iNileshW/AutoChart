# Backend runtime configuration for AutoChart.
# Copy to .env for local development. Do NOT commit real secrets.

# uvicorn bindings (backend_runner reads these)
AUTOCHART_HOST=127.0.0.1
AUTOCHART_PORT=8000
AUTOCHART_RELOAD=0

# CORS: comma-separated allow-list. Wildcards not allowed with credentials.
AUTOCHART_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional API key. When set, every /api/* and /mcp request must send
# X-API-Key: <this-value>. Leave blank/unset to disable the gate.
AUTOCHART_API_KEY=
AUTOCHART_API_KEY_HEADER=X-API-Key

# Logging
AUTOCHART_LOG_LEVEL=INFO
AUTOCHART_LOG_JSON=1
